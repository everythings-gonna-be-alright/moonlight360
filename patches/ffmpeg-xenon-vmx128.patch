+/* Sixteen bytes of n (0 to 255), made without a trip through memory: a vector load behind the store of the value
+ * would wait about 60 cycles on this CPU. lvsl gives the low four bits of an address as its first byte. */
+XV_INLINE xv_u8 xv_splat_byte(unsigned n)
+{
+    const xv_u8 low = vec_splat(vec_lvsl(0, (const uint8_t *)(uintptr_t)(n & 15)), 0);
+    const xv_u8 high = vec_splat(vec_lvsl(0, (const uint8_t *)(uintptr_t)(n >> 4)), 0);
+    return vec_add(low, vec_sl(high, vec_splat_u8(4)));
