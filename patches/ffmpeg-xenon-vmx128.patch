diff --git a/libavcodec/xenon_mpeg.h b/libavcodec/xenon_mpeg.h
new file mode 100644
index 0000000..f5058b1
--- /dev/null
+++ b/libavcodec/xenon_mpeg.h
@@ -0,0 +1,30 @@
+/* moonlight-xbox360: what the MPEG-2 decoder's slice threads spend where, for dev/bench's tune passes.
+ * Part of FFmpeg, under its license (LGPL 2.1 or later); patches/ffmpeg-xenon-vmx128.patch. */
+
+#ifndef AVCODEC_XENON_MPEG_H
+#define AVCODEC_XENON_MPEG_H
+
+#include <stdint.h>
+#include "config.h"
+
+/* Ticks of the timebase, and counts. A slice context's row is its first macroblock row, so no two threads share
+ * one. Blocks by kind: only a DC coefficient; that and the last coefficient MPEG-2's mismatch control toggles;
+ * then by the last coefficient's place in scan order, up to 2, 9, 20, and beyond. */
+enum { XMPROF_PARSE, XMPROF_MC, XMPROF_IDCT, XMPROF_TOTAL, XMPROF_MID, XMPROF_MBS, XMPROF_SKIPPED, XMPROF_INTRA,
+       XMPROF_NO_RESIDUAL, XMPROF_ZERO_MV, XMPROF_HPEL, XMPROF_BLOCKS = XMPROF_HPEL + 4, XMPROF_BLOCK_KIND,
+       XMPROF_N = 32 };
+enum { XMPROF_ROWS = 128 };
+
+extern int ff_xenon_prof, ff_xenon_tune;   /* h264dec.h */
+extern uint64_t ff_xenon_mpeg_prof[XMPROF_ROWS][XMPROF_N];
+
+static inline uint64_t ff_xenon_mpeg_ticks(void)
+{
+#if ARCH_PPC
+    return __builtin_ppc_get_timebase();
+#else
+    return 0;
+#endif
+}
+
+#endif
