+
+/* moonlight-xbox360 (ff_xenon_tune & 64): a block's first code read where the block is asked for, so that a block
+ * without coefficients, which most are, costs no call (26 cycles on Xenon, and a big function's registers saved and
+ * restored). left is the count of the block to the left when the caller has just read that block, or -1: read back
+ * from the cache it would be a load behind its store, about 40 cycles. *total gets this block's count for the same
+ * reason. split is a constant: without it this is FFmpeg's decode_residual. */
+static av_always_inline int residual(const H264Context *h, H264SliceContext *sl,
+                                     GetBitContext *gb, int16_t *block, int n,
+                                     const uint8_t *scantable, const uint32_t *qmul,
+                                     int max_coeff, int split, int left, int *total)
+{
+    int coeff_token;
+    if (!split) {
+        const int ret = decode_residual(h, sl, gb, block, n, scantable, qmul, max_coeff);
+        *total = sl->non_zero_count_cache[scan8[n]];
+        return ret;
+    }
+    if (max_coeff <= 8) {
+        if (max_coeff == 4)
+            coeff_token = get_vlc2(gb, chroma_dc_coeff_token_vlc_table,
+                                   CHROMA_DC_COEFF_TOKEN_VLC_BITS, 1);
+        else
+            coeff_token = get_vlc2(gb, chroma422_dc_coeff_token_vlc_table,
+                                   CHROMA422_DC_COEFF_TOKEN_VLC_BITS, 1);
+    } else {
+        const int index8 = scan8[n >= LUMA_DC_BLOCK_INDEX ? (n - LUMA_DC_BLOCK_INDEX) * 16 : n];
+        int i = (left >= 0 ? left : sl->non_zero_count_cache[index8 - 1]) + sl->non_zero_count_cache[index8 - 8];
+        if (i < 64)
+            i = (i + 1) >> 1;
+        coeff_token = get_vlc2(gb, coeff_token_vlc[i & 31], COEFF_TOKEN_VLC_BITS, 2);
+    }
+    *total = coeff_token >> 2;
+    sl->non_zero_count_cache[scan8[n]] = coeff_token >> 2;
+    if (!(coeff_token >> 2))
+        return 0;
+    return decode_residual_coefs(h, sl, gb, block, n, scantable, qmul, max_coeff, coeff_token);
+}
