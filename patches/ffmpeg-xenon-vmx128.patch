+/* Adds an inter block to its eight by eight pixels when the block's last coefficient in scan order is the first:
+ * then only the DC coefficient is set, and perhaps the very last one at 1, which MPEG-2's mismatch control toggles in
+ * about half of all blocks. Nearly half of a stream's blocks are of this kind. FFmpeg's simple IDCT, which the
+ * encoder's pictures are made with too, turns the DC coefficient alone into one value q for all 64 pixels, and the
+ * two together into q plus a pattern of -1, 0 and +1 that depends on the DC coefficient: 17 patterns in all, for
+ * most DC values the empty one. The tables hold them (made by trying every DC value against the IDCT's arithmetic;
+ * checked against ff_simple_idct_add_int16_8bit for each). The same pixels as the IDCT, without its multiplies.
+ * Returns 0, with nothing done, for a block or a destination it doesn't cover. dest is 8-aligned. */
+XV_INLINE int xm_dc_add(uint8_t *dest, ptrdiff_t stride, const int16_t *block)
+{
+    const int dc = block[0];
+    if ((unsigned)(dc + 2048) >= 4096 || (unsigned)block[63] > 1 || ((uintptr_t)dest & 7))
+        return 0;
+    const int q = (131064 * (dc + 4)) >> 20;   /* W4 * (8 * dc + 32) >> 20: -256 to 256 */
+    const int pattern = block[63] ? xm_mismatch_pattern[dc + 2048] : 0;
+    if (!pattern) {
+        /* One value for all: a saturating add or subtract of bytes clips as the IDCT's add does. */
+        if (!q)
+            return 1;
+        const int size = q < 0 ? -q : q;
+        const xv_u8 amount = xv_splat_byte(size > 255 ? 255 : size);   /* 255 already clips any pixel */
+        if (q > 0)
+            for (int y = 0; y < 8; y++, dest += stride)
+                xv_store8(dest, vec_adds(vec_ld(0, dest), amount), 0);
+        else
+            for (int y = 0; y < 8; y++, dest += stride)
+                xv_store8(dest, vec_subs(vec_ld(0, dest), amount), 0);
+        return 1;
+    }
+    const int8_t *const rows = xm_mismatch_patterns[pattern];
+    const xv_u8 high = q < 0 ? (xv_u8)vec_splat_s8(-1) : q > 255 ? vec_splat_u8(1) : vec_splat_u8(0);
+    const xv_s16 q16 = (xv_s16)vec_mergeh(high, xv_splat_byte(q & 255));
+    for (int y = 0; y < 8; y += 2) {
+        const xv_s8 two = vec_ld(y * 8, rows);
+        xv_s16 r = vec_add(vec_add(q16, vec_unpackh(two)), xv_widen(xv_load(dest, 7)));
+        xv_store8(dest, vec_packsu(r, r), 0);
+        dest += stride;
+        r = vec_add(vec_add(q16, vec_unpackl(two)), xv_widen(xv_load(dest, 7)));
+        xv_store8(dest, vec_packsu(r, r), 0);
+        dest += stride;
+    }
+    return 1;
+}
