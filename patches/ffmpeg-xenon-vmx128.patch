@@ -608,6 +609,9 @@ int ff_h264_decode_ref_pic_marking(H264SliceContext *sl, GetBitContext *gb,
                                    const H2645NAL *nal, void *logctx);
 
 void ff_h264_hl_decode_mb(const H264Context *h, H264SliceContext *sl);
+/* moonlight-xbox360 hybrid (h264_xenon.c): the rebuild itself, and the hook ff_h264_hl_decode_mb hands off to. */
+void ff_h264_hl_decode_mb_cpu(const H264Context *h, H264SliceContext *sl);
+extern void (*ff_h264_mb_hook)(const void *h, void *sl);
 void ff_h264_decode_init_vlc(void);
 
 /**
diff --git a/libavcodec/ppc/fdctdsp.c b/libavcodec/ppc/fdctdsp.c
