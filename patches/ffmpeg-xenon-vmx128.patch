+#if HAVE_ALTIVEC
+/* moonlight-xbox360: MPEG-2's block copies for Xenon (Xbox 360): whole-pixel and the three half-pixel cases, 16 and
+ * 8 pixels wide, with nothing but loads, averages and 16-bit adds. The source may lie anywhere; the destination is a
+ * macroblock's place in the picture, so 16-aligned (8 for chroma): anything else goes to the C version. A row reads
+ * at most 15 bytes further than the C code does. */
+#include "h264_xenon_vmx.h"
+
+extern int ff_xenon_tune;   /* h264dec.h */
+static op_pixels_func xenon_c_put[2][4];
+
+/* A row's bytes 0-15 in a and 1-16 in b. */
+XV_INLINE void xv_load17(const uint8_t *src, xv_u8 *a, xv_u8 *b)
+{
+    const xv_u8 v0 = vec_ld(0, src), v1 = vec_ld(16, src), shift = vec_lvsl(0, src);
+    *a = vec_perm(v0, v1, shift);
+    *b = vec_perm(v0, v1, vec_add(shift, vec_splat_u8(1)));
+}
+
+/* Bytes 0-7 of v in both halves, as xv_store8 wants them. */
+XV_INLINE xv_u8 xv_twice(xv_u8 v)
+{
+    static const xv_u8 halves = { 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7 };
+    return vec_perm(v, v, halves);
+}
+
+static void put16_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 15) {
+        xenon_c_put[0][0](block, pixels, stride, h);
+        return;
+    }
+    do {
+        vec_st(xv_load(pixels, 15), 0, block);
+        pixels += stride;
+        block += stride;
+    } while (--h);
+}
+
+static void put16_x2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 15) {
+        xenon_c_put[0][1](block, pixels, stride, h);
+        return;
+    }
+    do {
+        xv_u8 a, b;
+        xv_load17(pixels, &a, &b);
+        vec_st(vec_avg(a, b), 0, block);
+        pixels += stride;
+        block += stride;
+    } while (--h);
+}
+
+static void put16_y2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 15) {
+        xenon_c_put[0][2](block, pixels, stride, h);
+        return;
+    }
+    xv_u8 above = xv_load(pixels, 15);
+    do {
+        pixels += stride;
+        const xv_u8 below = xv_load(pixels, 15);
+        vec_st(vec_avg(above, below), 0, block);
+        above = below;
+        block += stride;
+    } while (--h);
+}
+
+/* A row's sums of each pixel and its right neighbour, as 16-bit values: pixels 0-7 and 8-15. */
+XV_INLINE void xv_pair_sums16(const uint8_t *src, xv_u16 *first, xv_u16 *second)
+{
+    const xv_u8 zero = vec_splat_u8(0);
+    xv_u8 a, b;
+    xv_load17(src, &a, &b);
+    *first = vec_add((xv_u16)vec_mergeh(zero, a), (xv_u16)vec_mergeh(zero, b));
+    *second = vec_add((xv_u16)vec_mergel(zero, a), (xv_u16)vec_mergel(zero, b));
+}
+
+static void put16_xy2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 15) {
+        xenon_c_put[0][3](block, pixels, stride, h);
+        return;
+    }
+    const xv_u16 two = vec_splat_u16(2);
+    xv_u16 above0, above1;
+    xv_pair_sums16(pixels, &above0, &above1);
+    do {
+        xv_u16 below0, below1;
+        pixels += stride;
+        xv_pair_sums16(pixels, &below0, &below1);
+        vec_st(vec_packsu(vec_sr(vec_add(vec_add(above0, below0), two), two),
+                          vec_sr(vec_add(vec_add(above1, below1), two), two)), 0, block);
+        above0 = below0;
+        above1 = below1;
+        block += stride;
+    } while (--h);
+}
+
+static void put8_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 7) {
+        xenon_c_put[1][0](block, pixels, stride, h);
+        return;
+    }
+    do {
+        xv_store8(block, xv_twice(xv_load(pixels, 7)), 0);
+        pixels += stride;
+        block += stride;
+    } while (--h);
+}
+
+static void put8_x2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 7) {
+        xenon_c_put[1][1](block, pixels, stride, h);
+        return;
+    }
+    do {
+        const xv_u8 a = xv_load(pixels, 8);
+        xv_store8(block, xv_twice(vec_avg(a, vec_sld(a, a, 1))), 0);
+        pixels += stride;
+        block += stride;
+    } while (--h);
+}
+
+static void put8_y2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 7) {
+        xenon_c_put[1][2](block, pixels, stride, h);
+        return;
+    }
+    xv_u8 above = xv_load(pixels, 7);
+    do {
+        pixels += stride;
+        const xv_u8 below = xv_load(pixels, 7);
+        xv_store8(block, xv_twice(vec_avg(above, below)), 0);
+        above = below;
+        block += stride;
+    } while (--h);
+}
+
+/* A row's sums of each of pixels 0-7 and its right neighbour. */
+XV_INLINE xv_s16 xv_pair_sums8(const uint8_t *src)
+{
+    const xv_u8 a = xv_load(src, 8);
+    return vec_add(xv_widen(a), xv_widen(vec_sld(a, a, 1)));
