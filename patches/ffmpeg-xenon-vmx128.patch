+/* moonlight-xbox360 (ff_xenon_tune & 8): a macroblock predicted as one 16x16 block from a whole-pixel position
+ * inside the reference picture, with no weighting, which is nearly every inter macroblock of a "lean" stream. Its
+ * 384 bytes are copied here, without the general path's bookkeeping. This CPU fetches nothing ahead by itself, so
+ * each time a row of pixels enters a new 128-byte cache line, the line after it is asked for in both pictures.
+ * Returns 0, having done nothing, for any other macroblock. */
+static av_always_inline int xenon_whole_pixel_mb(const H264Context *h, H264SliceContext *sl, int mb_type,
+                                                 uint8_t *dest_y, uint8_t *dest_cb, uint8_t *dest_cr)
+{
+    const int mx = sl->mv_cache[0][scan8[0]][0], my = sl->mv_cache[0][scan8[0]][1];
+    const int x = (mx >> 2) + 16 * sl->mb_x, y = (my >> 2) + 16 * sl->mb_y;
+    const int refn = sl->ref_cache[0][scan8[0]];
+    const ptrdiff_t stride = sl->linesize, cstride = sl->uvlinesize;
+    const int prefetch = !(ff_xenon_tune & (16 | 128));
+    int i;
+    if (!IS_16X16(mb_type) || USES_LIST(mb_type, 1) || refn < 0 || sl->pwt.use_weight || ((mx | my) & 3) ||
+        x < 0 || y < 0 || x + 16 > 16 * h->mb_width || y + 16 > 16 * h->mb_height)
+        return 0;
+    const H264Ref *const ref = &sl->ref_list[0][refn];
+    const uint8_t *src = ref->data[0] + x + y * stride;
+    const xv_u8 shift = vec_lvsl(0, src);
+    if (prefetch) {
+        if (((uintptr_t)src & 127) < 16)
+            for (i = 0; i < 16; i++)
+                __asm__ volatile ("dcbt 0,%0" : : "r" (src + 128 + i * stride));
+        if (((uintptr_t)dest_y & 127) < 16)
+            for (i = 0; i < 16; i++)
+                __asm__ volatile ("dcbtst 0,%0" : : "r" (dest_y + 128 + i * stride));
+    }
+    for (i = 0; i < 16; i++, src += stride, dest_y += stride)
+        vec_st(vec_perm(vec_ld(0, src), vec_ld(15, src), shift), 0, dest_y);
+
+    const int cx = (mx >> 3) + 8 * sl->mb_x, cy = (my >> 3) + 8 * sl->mb_y;
+    const uint8_t *src_cb = ref->data[1] + cx + cy * cstride, *src_cr = ref->data[2] + cx + cy * cstride;
+    if (prefetch) {
+        if (((uintptr_t)src_cb & 127) < 8)
+            for (i = 0; i < 8; i++) {
+                __asm__ volatile ("dcbt 0,%0" : : "r" (src_cb + 128 + i * cstride));
+                __asm__ volatile ("dcbt 0,%0" : : "r" (src_cr + 128 + i * cstride));
+            }
+        if (((uintptr_t)dest_cb & 127) < 8)
+            for (i = 0; i < 8; i++) {
+                __asm__ volatile ("dcbtst 0,%0" : : "r" (dest_cb + 128 + i * cstride));
+                __asm__ volatile ("dcbtst 0,%0" : : "r" (dest_cr + 128 + i * cstride));
+            }
+    }
+    if ((mx | my) & 7) {
+        /* An odd whole pixel of luma is half a pixel of chroma. */
+        h->h264chroma.put_h264_chroma_pixels_tab[0](dest_cb, src_cb, cstride, 8, mx & 7, my & 7);
+        h->h264chroma.put_h264_chroma_pixels_tab[0](dest_cr, src_cr, cstride, 8, mx & 7, my & 7);
+    } else {
+        xv_h264_chroma_mc8(dest_cb, src_cb, cstride, 8, 0, 0, 0);
+        xv_h264_chroma_mc8(dest_cr, src_cr, cstride, 8, 0, 0, 0);
+    }
+    if (ff_xenon_prof)
+        ff_xenon_prof_slice[sl - h->slice_ctx][XPROF_FAST_MBS]++;
+    return 1;
+}
