+/* Xenon's VMX128 (Xbox 360) has no vector integer multiplies (vmladduhm, vmule*, vmulo*): the lowpass filters only
+ * multiply by 20, 5 and 1, which shifts and adds do exactly. */
+static av_always_inline vec_s16 xenon_mul20_add(vec_s16 x, vec_s16 y)
+{
+    return vec_add(vec_add(vec_sl(x, vec_splat_u16(4)), vec_sl(x, vec_splat_u16(2))), y);
+}
+static av_always_inline vec_s16 xenon_mul5(vec_s16 x)
+{
+    return vec_add(vec_sl(x, vec_splat_u16(2)), x);
+}
+/* The even and odd 16-bit lanes, sign-extended to 32 bits (big-endian: even lanes are each word's high half). */
+static av_always_inline vec_s32 xenon_even_s32(vec_s16 x)
+{
+    return vec_sra((vec_s32)x, vec_sl(vec_splat_u32(1), vec_splat_u32(4)));
+}
+static av_always_inline vec_s32 xenon_odd_s32(vec_s16 x)
+{
+    const vec_u32 sixteen = vec_sl(vec_splat_u32(1), vec_splat_u32(4));
+    return vec_sra(vec_sl((vec_s32)x, sixteen), sixteen);
+}
+static av_always_inline vec_s32 xenon_mul20_s32(vec_s32 x)
+{
+    return vec_add(vec_sl(x, vec_splat_u32(4)), vec_sl(x, vec_splat_u32(2)));
+}
+static av_always_inline vec_s32 xenon_mul5_s32(vec_s32 x)
+{
+    return vec_add(vec_sl(x, vec_splat_u32(2)), x);
+}
