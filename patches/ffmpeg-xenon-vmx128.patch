+
+static void put8_xy2_xenon(uint8_t *block, const uint8_t *pixels, ptrdiff_t stride, int h)
+{
+    if ((uintptr_t)block & 7) {
+        xenon_c_put[1][3](block, pixels, stride, h);
+        return;
+    }
+    const xv_s16 two = vec_splat_s16(2);
+    xv_s16 above = xv_pair_sums8(pixels);
+    do {
+        pixels += stride;
+        const xv_s16 below = xv_pair_sums8(pixels);
+        const xv_s16 r = vec_sra(vec_add(vec_add(above, below), two), vec_splat_u16(2));
+        xv_store8(block, vec_packsu(r, r), 0);
+        above = below;
+        block += stride;
+    } while (--h);
