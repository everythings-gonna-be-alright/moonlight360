+    { 0, 0, 0, 0, 2, -6, 9, -11 }, { 0, 0, 0, 0, 11, -9, 6, -2 },
+};
+#define XM_MISMATCH_B(w) { 2 * (w), -6 * (w), 9 * (w), -11 * (w) }, { 11 * (w), -9 * (w), 6 * (w), -2 * (w) }
+static const int32_t xm_mismatch_b[4][2][4] __attribute__((aligned(16))) = {
+    { XM_MISMATCH_B(XM_W7) }, { XM_MISMATCH_B(-XM_W5) }, { XM_MISMATCH_B(XM_W3) }, { XM_MISMATCH_B(-XM_W1) },
+};
