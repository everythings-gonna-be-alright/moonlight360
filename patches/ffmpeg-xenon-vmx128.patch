+        if (!(four)) { \
+            const xv_s16 rt2 = vec_mergel(rr0, r2), rt3 = vec_mergel(r1, r3); \
+            c45 = vec_mergeh(rt2, rt3); \
+            c67 = vec_mergel(rt2, rt3); \
+        } \
+        xv_s32 ro0, ro1, ro2, ro3, ro4, ro5, ro6, ro7; \
+        XM_PASS(c01, c23, c45, c67, 1, (four) ? XM_FOUR : XM_ALL, 0, ro0, ro1, ro2, ro3, ro4, ro5, ro6, ro7); \
+        /* Back to a row a group of four, cut to 16 bits. */ \
+        const xv_s16 p02 = vec_pack(ro0, ro2), p13 = vec_pack(ro1, ro3); \
+        const xv_s16 p46 = vec_pack(ro4, ro6), p57 = vec_pack(ro5, ro7); \
+        const xv_s32 m0 = (xv_s32)vec_mergeh(p02, p13), m1 = (xv_s32)vec_mergel(p02, p13); \
+        const xv_s32 m2 = (xv_s32)vec_mergeh(p46, p57), m3 = (xv_s32)vec_mergel(p46, p57); \
+        y01 = (xv_s16)vec_mergeh(m0, m1); \
+        y23 = (xv_s16)vec_mergel(m0, m1); \
+        z01 = (xv_s16)vec_mergeh(m2, m3); \
+        z23 = (xv_s16)vec_mergel(m2, m3); \
+    } while (0)
+
+/* The column pass over four columns: two rows a vector in, two rows a vector out (16 bits, the four columns of one
+ * row, then of the next). */
+#define XM_COLUMN_PASS(y01, y23, y45, y67, inputs, half, q01, q23, q45, q67) \
+    do { \
+        xv_s16 cy01 = y01, cy23 = y23, cy45 = y45, cy67 = y67; \
+        XM_FROM_HERE(cy01); \
+        XM_FROM_HERE(cy23); \
+        XM_FROM_HERE(cy45); \
+        XM_FROM_HERE(cy67); \
+        xv_s32 co0, co1, co2, co3, co4, co5, co6, co7; \
+        XM_PASS(cy01, cy23, cy45, cy67, 0, inputs, half, co0, co1, co2, co3, co4, co5, co6, co7); \
+        q01 = vec_packs(co0, co1); \
+        q23 = vec_packs(co2, co3); \
+        q45 = vec_packs(co4, co5); \
+        q67 = vec_packs(co6, co7); \
+    } while (0)
+
+/* Two rows of results (columns 0 to 3 in q, 4 to 7 in w) added to the pixels at dest, or put there. */
+XV_INLINE uint8_t *xm_two_rows(uint8_t *dest, ptrdiff_t stride, xv_s16 q, xv_s16 w, int add)
+{
+    xv_s16 first = vec_perm(q, w, vec_ld(0, xm_halves[0])), second = vec_perm(q, w, vec_ld(0, xm_halves[1]));
+    if (add)
+        first = vec_add(first, xv_widen(xv_load(dest, 7)));
+    xv_store8(dest, vec_packsu(first, first), 0);
+    dest += stride;
+    if (add)
+        second = vec_add(second, xv_widen(xv_load(dest, 7)));
+    xv_store8(dest, vec_packsu(second, second), 0);
+    return dest + stride;
+}
+
+/* The block's transform, added to the 8x8 pixels at dest (add) or put there. block and dest's rows are aligned as
+ * the decoder has them: the block to 16 bytes, dest to 8. Leaves the block as it was. */
+XV_INLINE void xm_idct(uint8_t *dest, ptrdiff_t stride, const int16_t *block, int add)
+{
+    typedef uint64_t __attribute__((may_alias)) xm_u64;
+    const xm_u64 *const halves = (const xm_u64 *)block;   /* half a row of the block each; big-endian, so the last
+                                                             holding only the mismatch bit reads as 1 */
+    const xv_s16 r0 = vec_ld(0, block), r1 = vec_ld(16, block), r2 = vec_ld(32, block), r3 = vec_ld(48, block);
+    xv_s16 y01, y23, z01, z23, q01, q23, q45, q67, w01, w23, w45, w67;
+
+    if (halves[1] | halves[3] | halves[5] | halves[7])
+        XM_ROW_PASS(r0, r1, r2, r3, 0, y01, y23, z01, z23);
+    else
+        XM_ROW_PASS(r0, r1, r2, r3, 1, y01, y23, z01, z23);
+    if (halves[8] | halves[9] | halves[10] | halves[11] | halves[12] | halves[13] | halves[14] | (halves[15] > 1)) {
+        const xv_s16 r4 = vec_ld(64, block), r5 = vec_ld(80, block), r6 = vec_ld(96, block), r7 = vec_ld(112, block);
+        xv_s16 y45, y67, z45, z67;
+        XM_ROW_PASS(r4, r5, r6, r7, 0, y45, y67, z45, z67);
+        XM_COLUMN_PASS(y01, y23, y45, y67, XM_ALL, 0, q01, q23, q45, q67);
+        XM_COLUMN_PASS(z01, z23, z45, z67, XM_ALL, 1, w01, w23, w45, w67);
+    } else if (halves[15]) {
+        XM_COLUMN_PASS(y01, y23, y01, y01, XM_FOUR_AND_MISMATCH, 0, q01, q23, q45, q67);
+        XM_COLUMN_PASS(z01, z23, z01, z01, XM_FOUR_AND_MISMATCH, 1, w01, w23, w45, w67);
+    } else {
+        XM_COLUMN_PASS(y01, y23, y01, y01, XM_FOUR, 0, q01, q23, q45, q67);
+        XM_COLUMN_PASS(z01, z23, z01, z01, XM_FOUR, 1, w01, w23, w45, w67);
+    }
+    dest = xm_two_rows(dest, stride, q01, w01, add);
+    dest = xm_two_rows(dest, stride, q23, w23, add);
+    dest = xm_two_rows(dest, stride, q45, w45, add);
+    xm_two_rows(dest, stride, q67, w67, add);
+}
+
+void ff_xenon_idct_add(uint8_t *dest, ptrdiff_t stride, int16_t *block);   /* ppc/idctdsp.c */
+void ff_xenon_idct_put(uint8_t *dest, ptrdiff_t stride, int16_t *block);
+
+#endif
