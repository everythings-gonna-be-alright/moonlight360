+    { XM_W5, XM_W5, XM_W5, XM_W5 }, { XM_W6, XM_W6, XM_W6, XM_W6 }, { XM_W7, XM_W7, XM_W7, XM_W7 },
+};
+static const int32_t xm_ints[3][4] __attribute__((aligned(16))) = {
+    { 255, 255, 255, 255 }, { 524256, 524256, 524256, 524256 } /* W4 * 32 */, { 20, 20, 20, 20 },
+};
