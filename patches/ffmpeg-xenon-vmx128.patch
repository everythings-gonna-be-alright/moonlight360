+    uint64_t *const p = ff_xenon_prof_slice[sl - h->slice_ctx];
+    p[XPROF_MID] = 0;
+    const uint64_t t0 = ff_xenon_ticks();
+    const int ret = decode_mb_cavlc(h, sl);
+    const uint64_t t1 = ff_xenon_ticks(), mid = p[XPROF_MID];
+    p[XPROF_MBS]++;
+    if (mid) {
+        p[XPROF_HEAD] += mid - t0;
+        p[XPROF_RESIDUAL] += t1 - mid;
+    } else if (ret >= 0 && IS_SKIP(h->cur_pic.mb_type[sl->mb_xy])) {
+        p[XPROF_SKIP] += t1 - t0;
+        p[XPROF_SKIPPED]++;
+    } else {
+        p[XPROF_HEAD] += t1 - t0;
+    }
+    return ret;
