+/* Which of a pass's eight inputs there are: all; x0 to x3 only (the rest are zero and not looked at); or, in the
+ * column pass, x0 to x3 and the mismatch bit's row 7, whose share is the constants above. */
+enum { XM_ALL, XM_FOUR, XM_FOUR_AND_MISMATCH };
