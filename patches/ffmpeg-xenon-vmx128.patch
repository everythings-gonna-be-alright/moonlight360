+static av_noinline int decode_residual_coefs(const H264Context *h, H264SliceContext *sl,
+                                             GetBitContext *gb, int16_t *block, int n,
+                                             const uint8_t *scantable, const uint32_t *qmul,
+                                             int max_coeff, int token)
