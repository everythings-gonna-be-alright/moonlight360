     if (!PPC_ALTIVEC(av_get_cpu_flags()))
         return;
diff --git a/libavcodec/ppc/h264_xenon_vmx.h b/libavcodec/ppc/h264_xenon_vmx.h
new file mode 100644
index 0000000..9aac591
--- /dev/null
+++ b/libavcodec/ppc/h264_xenon_vmx.h
@@ -0,0 +1,249 @@
+/* H.264 chroma prediction and chroma deblocking for Xenon's VMX128 (Xbox 360), without vector integer multiplies.
+ * Part of FFmpeg, under its license (LGPL 2.1 or later, COPYING.LGPLv2.1); patches/ffmpeg-xenon-vmx128.patch.
+ * Self-contained (altivec.h only): dev/vmx_test checks each function against FFmpeg's C code under QEMU. */
+
+#ifndef AVCODEC_PPC_H264_XENON_VMX_H
+#define AVCODEC_PPC_H264_XENON_VMX_H
+
+#include <altivec.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef __vector unsigned char xv_u8;
+typedef __vector signed char xv_s8;
+typedef __vector unsigned short xv_u16;
+typedef __vector signed short xv_s16;
+typedef __vector unsigned int xv_u32;
+
+#define XV_INLINE static inline __attribute__((always_inline))
+
+/* 16 bytes from src, of which bytes 0 to last are needed: never touches a 16-byte block past the one holding
+ * src[last], so it reads no further into memory than the C code does. */
+XV_INLINE xv_u8 xv_load(const uint8_t *src, int last)
+{
+    return vec_perm(vec_ld(0, src), vec_ld(last, src), vec_lvsl(0, src));
+}
+
+/* A weight of 0 to 7 as three masks, its bits 0, 1 and 2. */
+typedef struct {
+    xv_s16 bit0, bit1, bit2;
+} XvWeight;
+
+XV_INLINE XvWeight xv_weight(int w)
+{
+    const xv_s16 on = vec_splat_s16(-1), off = vec_splat_s16(0);
+    const XvWeight r = { w & 1 ? on : off, w & 2 ? on : off, w & 4 ? on : off };
+    return r;
+}
+
+/* (8 - w) * a + w * b, as 8a + w(b - a). */
+XV_INLINE xv_s16 xv_weigh(xv_s16 a, xv_s16 b, XvWeight w)
+{
+    const xv_s16 d = vec_sub(b, a);
+    xv_s16 r = vec_sl(a, vec_splat_u16(3));
+    r = vec_add(r, vec_and(d, w.bit0));
+    r = vec_add(r, vec_and(vec_sl(d, vec_splat_u16(1)), w.bit1));
+    return vec_add(r, vec_and(vec_sl(d, vec_splat_u16(2)), w.bit2));
+}
+
+/* Bytes 0 to 7 of v as eight 16-bit values. */
+XV_INLINE xv_s16 xv_widen(xv_u8 v)
+{
+    return (xv_s16)vec_mergeh(vec_splat_u8(0), v);
+}
+
+/* A row's eight pixels weighed with their right neighbours: (8 - x) * src[i] + x * src[i + 1]. */
+XV_INLINE xv_s16 xv_chroma_row(const uint8_t *src, int last, XvWeight wx)
+{
+    const xv_u8 v = xv_load(src, last);
+    return xv_weigh(xv_widen(v), xv_widen(vec_sld(v, v, 1)), wx);
+}
+
+/* Stores eight result bytes, held twice in r (bytes 0-7 and 8-15), at dst, which is 8-aligned: stvewx takes the
+ * word of r that the address selects. Only those eight bytes are written (another slice's thread may be writing the
+ * block beside them). With avg, the average with what dst holds, rounded up. */
+XV_INLINE void xv_store8(uint8_t *dst, xv_u8 r, int avg)
+{
+    if (avg)
+        r = vec_avg(r, vec_ld(0, dst));
+    vec_ste((xv_u32)r, 0, (unsigned int *)dst);
+    vec_ste((xv_u32)r, 4, (unsigned int *)dst);
+}
+
+/* FFmpeg's put/avg_h264_chroma_mc8 (h264chroma_template.c), bit for bit: an 8-wide block, h rows, at the
+ * eighth-pixel offset (x, y). The four weights factor into a horizontal pass, then a vertical one. dst 8-aligned. */
+XV_INLINE void xv_h264_chroma_mc8(uint8_t *dst, const uint8_t *src, ptrdiff_t stride, int h, int x, int y, int avg)
+{
+    const xv_u16 three = vec_splat_u16(3), four = vec_splat_u16(4), six = vec_splat_u16(6);
+    const xv_u16 thirty_two = vec_sl(vec_splat_u16(1), vec_splat_u16(5));
+    int i;
+    if (!(x | y)) {
+        /* Whole-pixel: a copy. Bytes 0-7 into both halves for the store. */
+        const xv_u8 twice = vec_and(vec_lvsl(0, (unsigned char *)0), vec_splat_u8(7));
+        for (i = 0; i < h; i++, src += stride, dst += stride) {
+            const xv_u8 v = xv_load(src, 7);
+            xv_store8(dst, vec_perm(v, v, twice), avg);
+        }
+    } else if (!y) {
+        /* Horizontal only: the row below is never read. ((8-x)a + xb) * 8 + 32 >> 6 */
+        const XvWeight wx = xv_weight(x);
+        for (i = 0; i < h; i++, src += stride, dst += stride) {
+            const xv_s16 row = xv_chroma_row(src, 8, wx);
+            const xv_s16 r = (xv_s16)vec_sr((xv_u16)vec_add(row, (xv_s16)four), three);
+            xv_store8(dst, vec_packsu(r, r), avg);
+        }
+    } else if (!x) {
+        /* Vertical only: the column to the right is never read. */
+        const XvWeight wy = xv_weight(y);
+        xv_s16 above = xv_widen(xv_load(src, 7));
+        for (i = 0; i < h; i++, dst += stride) {
+            src += stride;
+            const xv_s16 below = xv_widen(xv_load(src, 7));
+            const xv_s16 r = (xv_s16)vec_sr((xv_u16)vec_add(xv_weigh(above, below, wy), (xv_s16)four), three);
+            xv_store8(dst, vec_packsu(r, r), avg);
+            above = below;
+        }
+    } else {
+        const XvWeight wx = xv_weight(x), wy = xv_weight(y);
+        xv_s16 above = xv_chroma_row(src, 8, wx);
+        for (i = 0; i < h; i++, dst += stride) {
+            src += stride;
+            const xv_s16 below = xv_chroma_row(src, 8, wx);
+            const xv_s16 r = (xv_s16)vec_sr((xv_u16)vec_add(xv_weigh(above, below, wy), (xv_s16)thirty_two), six);
+            xv_store8(dst, vec_packsu(r, r), avg);
+            above = below;
+        }
+    }
+}
+
+/* ---- chroma deblocking ---- */
+
+/* |a - b| < limit, per byte. */
+XV_INLINE xv_u8 xv_diff_lt(xv_u8 a, xv_u8 b, xv_u8 limit)
+{
+    return (xv_u8)vec_cmplt(vec_or(vec_subs(a, b), vec_subs(b, a)), limit);
+}
+
+/* Which pixels an edge filters: |p0-q0| < alpha, |p1-p0| < beta, |q1-q0| < beta. */
+XV_INLINE xv_u8 xv_deblock_mask(xv_u8 p1, xv_u8 p0, xv_u8 q0, xv_u8 q1, xv_u8 alpha, xv_u8 beta)
+{
+    return vec_and(vec_and(xv_diff_lt(p0, q0, alpha), xv_diff_lt(p1, p0, beta)), xv_diff_lt(q1, q0, beta));
+}
+
+/* The normal filter: delta = clip(((q0 - p0) * 4 + (p1 - q1) + 4) >> 3, -tc, tc), p0 += delta, q0 -= delta; tc is
+ * zero for pixels left alone. In bytes, as FFmpeg's AltiVec luma filter (ppc/h264dsp.c, h264_deblock_p0_q0). */
+XV_INLINE void xv_deblock_p0_q0(xv_u8 p1, xv_u8 *p0, xv_u8 *q0, xv_u8 q1, xv_u8 tc)
+{
+    const xv_u8 one = vec_splat_u8(1);
+    const xv_u8 v160 = vec_sl(vec_splat_u8(10), vec_splat_u8(4));
+    xv_u8 stage1 = vec_avg(p1, vec_nor(q1, q1));         /* (p1 - q1 + 256) >> 1 */
+    xv_u8 stage2 = vec_sr(stage1, one);                  /* 64 + (p1 - q1) >> 2 */
+    stage1 = vec_avg(*q0, vec_nor(*p0, *p0));            /* (q0 - p0 + 256) >> 1 */
+    stage2 = vec_avg(stage2, vec_and(vec_xor(*p0, *q0), one));
+    stage2 = vec_adds(stage2, stage1);                   /* 160 + delta */
+    const xv_u8 down = vec_min(tc, vec_subs(v160, stage2));   /* -delta where negative, clipped */
+    const xv_u8 up = vec_min(tc, vec_subs(stage2, v160));     /* delta where positive, clipped */
+    *p0 = vec_adds(vec_subs(*p0, down), up);
+    *q0 = vec_adds(vec_subs(*q0, up), down);
+}
+
+/* The strong (intra) filter: p0 = (2 * p1 + p0 + q1 + 2) >> 2, likewise q0. In bytes: the average of p1 with the
+ * floor of (p0 + q1) / 2, rounded up, is the same number. */
+XV_INLINE xv_u8 xv_deblock_intra(xv_u8 p1, xv_u8 p0, xv_u8 q1)
+{
+    const xv_u8 floor_avg = vec_sub(vec_avg(p0, q1), vec_and(vec_xor(p0, q1), vec_splat_u8(1)));
+    return vec_avg(floor_avg, p1);
+}
+
+/* alpha, beta and the four tc values as vectors: tc as { t0, t0, t1, t1, t2, t2, t3, t3 } in both halves, a value for
+ * every two pixels of the edge. One trip through memory for all of them. */
+typedef struct {
+    xv_u8 alpha, beta, tc;
+} XvDeblock;
+
+XV_INLINE XvDeblock xv_deblock_params(int alpha, int beta, const int8_t *tc0)
+{
+    union {
+        xv_u8 v;
+        uint8_t b[16];
+    } t;
+    XvDeblock r;
+    t.b[0] = (uint8_t)alpha;
+    t.b[1] = (uint8_t)beta;
+    t.b[2] = t.b[3] = t.b[4] = t.b[5] = 0;
+    if (tc0) {
+        t.b[2] = (uint8_t)tc0[0];
+        t.b[3] = (uint8_t)tc0[1];
+        t.b[4] = (uint8_t)tc0[2];
+        t.b[5] = (uint8_t)tc0[3];
+    }
+    const xv_u8 params = vec_ld(0, t.b);
+    const xv_u8 twice = vec_and(vec_lvsl(0, (unsigned char *)0), vec_splat_u8(7));
+    const xv_u8 tc = vec_sld(params, params, 2);
+    const xv_u8 pairs = vec_perm(vec_mergeh(tc, tc), tc, twice);
+    r.alpha = vec_splat(params, 0);
+    r.beta = vec_splat(params, 1);
+    /* tc of zero or less: the pixels are left alone. */
+    r.tc = vec_and(pairs, (xv_u8)vec_cmpgt((xv_s8)pairs, vec_splat_s8(0)));
+    return r;
+}
+
+/* The filter on four vectors holding p1, p0, q0, q1; tc0 NULL for the intra filter. */
+XV_INLINE void xv_deblock_chroma(xv_u8 p1, xv_u8 *p0, xv_u8 *q0, xv_u8 q1, int alpha, int beta, const int8_t *tc0)
+{
+    const XvDeblock d = xv_deblock_params(alpha, beta, tc0);
+    const xv_u8 mask = xv_deblock_mask(p1, *p0, *q0, q1, d.alpha, d.beta);
+    if (tc0) {
+        xv_deblock_p0_q0(p1, p0, q0, q1, vec_and(d.tc, mask));
+    } else {
+        const xv_u8 new_p0 = xv_deblock_intra(p1, *p0, q1), new_q0 = xv_deblock_intra(q1, *q0, p1);
+        *p0 = vec_sel(*p0, new_p0, mask);
+        *q0 = vec_sel(*q0, new_q0, mask);
+    }
+}
+
+/* FFmpeg's h264_v_loop_filter_chroma (tc0 given) and its _intra (tc0 NULL), 8-bit: a horizontal edge, 8 pixels wide,
+ * pix 8-aligned on the row under it. The rows are loaded as the 16-byte blocks holding them; only the edge's own
+ * eight bytes of each are written back. */
+XV_INLINE void xv_h264_v_loop_filter_chroma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, const int8_t *tc0)
+{
+    const xv_u8 p1 = vec_ld(0, pix - 2 * stride), q1 = vec_ld(0, pix + stride);
+    xv_u8 p0 = vec_ld(0, pix - stride), q0 = vec_ld(0, pix);
+    xv_deblock_chroma(p1, &p0, &q0, q1, alpha, beta, tc0);
+    vec_ste((xv_u32)p0, 0, (unsigned int *)(pix - stride));
+    vec_ste((xv_u32)p0, 4, (unsigned int *)(pix - stride));
+    vec_ste((xv_u32)q0, 0, (unsigned int *)pix);
+    vec_ste((xv_u32)q0, 4, (unsigned int *)pix);
+}
+
+/* FFmpeg's h264_h_loop_filter_chroma (tc0 given) and its _intra (tc0 NULL), 8-bit: a vertical edge, 8 rows, pix at
+ * an even address on the column right of it. Each row's four pixels around the edge are gathered into p1, p0, q0, q1
+ * by rows; the two changed pixels of each row go back with byte stores. */
+XV_INLINE void xv_h264_h_loop_filter_chroma(uint8_t *pix, ptrdiff_t stride, int alpha, int beta, const int8_t *tc0)
+{
+    uint8_t *const row = pix - 2;
+    const xv_u8 r0 = xv_load(row, 3), r1 = xv_load(row + stride, 3);
+    const xv_u8 r2 = xv_load(row + 2 * stride, 3), r3 = xv_load(row + 3 * stride, 3);
+    const xv_u8 r4 = xv_load(row + 4 * stride, 3), r5 = xv_load(row + 5 * stride, 3);
+    const xv_u8 r6 = xv_load(row + 6 * stride, 3), r7 = xv_load(row + 7 * stride, 3);
+    /* Columns out of rows: three rounds of merges put the rows' first bytes side by side, then their second... */
+    const xv_u8 even = vec_mergeh(vec_mergeh(r0, r4), vec_mergeh(r2, r6));
+    const xv_u8 odd = vec_mergeh(vec_mergeh(r1, r5), vec_mergeh(r3, r7));
+    const xv_u8 p = vec_mergeh(even, odd), q = vec_mergel(even, odd);   /* p1 then p0; q0 then q1 */
+    const xv_u8 p1 = p, q1 = vec_sld(q, q, 8);
+    xv_u8 p0 = vec_sld(p, p, 8), q0 = q;
+    xv_deblock_chroma(p1, &p0, &q0, q1, alpha, beta, tc0);
+    /* { q0, p0 } of each row as a 16-bit value, splat across a vector: its odd bytes are that row's p0, its even ones
+     * q0, and stvebx stores the byte its address selects: p0 at pix - 1 (odd), q0 at pix (even). */
+    const xv_u16 pairs = (xv_u16)vec_mergeh(q0, p0);
+#define XV_STORE_ROW(n) { \
+        const xv_u8 both = (xv_u8)vec_splat(pairs, n); \
+        vec_ste(both, -1, pix + n * stride); \
+        vec_ste(both, 0, pix + n * stride); \
+    }
+    XV_STORE_ROW(0) XV_STORE_ROW(1) XV_STORE_ROW(2) XV_STORE_ROW(3)
+    XV_STORE_ROW(4) XV_STORE_ROW(5) XV_STORE_ROW(6) XV_STORE_ROW(7)
+#undef XV_STORE_ROW
+}
+
