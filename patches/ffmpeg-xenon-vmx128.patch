+static av_always_inline vec_s32 xenon_odd_s32(vec_s16 x)
+{
+    const vec_u32 sixteen = vec_sl(vec_splat_u32(1), vec_splat_u32(4));
+    return vec_sra(vec_sl((vec_s32)x, sixteen), sixteen);
+}
+static av_always_inline vec_s32 xenon_mul20_s32(vec_s32 x)
+{
+    return vec_add(vec_sl(x, vec_splat_u32(4)), vec_sl(x, vec_splat_u32(2)));
+}
+static av_always_inline vec_s32 xenon_mul5_s32(vec_s32 x)
+{
+    return vec_add(vec_sl(x, vec_splat_u32(2)), x);
