+/* A constant from memory, loaded where it is used: the compiler would otherwise hold every constant of the
+ * transform in a register from start to end, and has only 32 for the lot. What doesn't fit goes to the stack, and
+ * a value read back soon after it was stored there costs this CPU some 60 cycles. */
+XV_INLINE xv_f32 xm_weight(int i)
+{
+    const float *p = xm_w[i];
+    __asm__("" : "+b"(p));
+    return vec_ld(0, p);
+}
+
+XV_INLINE xv_s32 xm_int(int i)
+{
+    const int32_t *p = xm_ints[i];
+    __asm__("" : "+b"(p));
+    return vec_ld(0, p);
