diff --git a/include/xsdk/display.h b/include/xsdk/display.h
index 0e307d0..05921d0 100644
--- a/include/xsdk/display.h
+++ b/include/xsdk/display.h
@@ -18,6 +18,11 @@ typedef enum {
 	XSDK_DISPLAY_720P,
 	// The kernel's own front buffer and scaling, 640x480 on the console tested.
 	XSDK_DISPLAY_KERNEL,
+	// 1920x1080 shown 1:1 with the scaler off, as libxenon shows a mode (xenos.c:381-417), where the console outputs
+	// 1920x1080 progressive to a widescreen screen; XSDK_DISPLAY_720P elsewhere. The target is past half of eDRAM,
+	// so it is set with xsdk_gpu_set_target_at(1920, 1080, 0, 0) and resolved without a depth clear
+	// (xsdk_gpu_set_resolve_clears). Not with the splash.
+	XSDK_DISPLAY_1080P,
 } XsdkDisplayMode;
 
 // Takes the display and returns the front buffer's size; STATUS_NOT_SUPPORTED where there is none, as in Xenia.
diff --git a/src/display.c b/src/display.c
index 2c81e3f..29e676f 100644
--- a/src/display.c
+++ b/src/display.c
@@ -51,6 +51,8 @@ enum {
 	LUT_ALL_CHANNELS = 7,
 	WIDTH_720P = 1280,
 	HEIGHT_720P = 720,
+	WIDTH_1080P = 1920,
+	HEIGHT_1080P = 1080,
 	SCALE_ONE_LOG2 = 24,
 	// 2 taps each way through the built-in filter, the only setting that scaled whole (docs/HARDWARE.md).
 	TWO_TAPS = 0x101,
@@ -92,6 +94,7 @@ static const uint32_t scaler_registers[SCALER_REGISTERS] = { AVIVO_D1SCL_SCALER_
 	UNKNOWN_1972 };
 
 static bool is_open;
+static uint32_t mode_width;
 static uint32_t mode_height;
 static Surface old_surface;
 // Set while the title's front buffer is 1280x720 on the SDK's scaling rather than the kernel's.
@@ -154,8 +157,8 @@ static void plan_values(uint32_t width, uint32_t height, uint32_t *values)
 	values[VERTICAL_PHASE] = phase(vertical);
 }
 
-// Plans 1280x720 filling the output.
-static bool plan_scaler(void)
+// Plans 1280x720 filling the output, or for the 1080p mode on a 1920x1080 widescreen output, 1920x1080 shown 1:1.
+static bool plan_scaler(XsdkDisplayMode mode)
 {
 	VIDEO_MODE video;
 	VdQueryVideoMode(&video);
@@ -169,9 +172,14 @@ static bool plan_scaler(void)
 	output_width = video.display_width;
 	output_height = video.display_height;
 	letterboxed = !video.is_widescreen || letterbox_forced;
-	plan_values(WIDTH_720P, HEIGHT_720P, new_scaler);
-	xsdk_log_write("display: 1280x720 %s to the %ux%u output", new_scaler[SCALER_ENABLE] ? "scaled" : "shown 1:1",
-		(unsigned)video.display_width, (unsigned)video.display_height);
+	const bool native = mode == XSDK_DISPLAY_1080P && !letterboxed && video.display_width == WIDTH_1080P &&
+		video.display_height == HEIGHT_1080P;
+	mode_width = native ? WIDTH_1080P : WIDTH_720P;
+	mode_height = native ? HEIGHT_1080P : HEIGHT_720P;
+	plan_values(mode_width, mode_height, new_scaler);
+	xsdk_log_write("display: %ux%u %s to the %ux%u output", (unsigned)mode_width, (unsigned)mode_height,
+		new_scaler[SCALER_ENABLE] ? "scaled" : "shown 1:1", (unsigned)video.display_width,
+		(unsigned)video.display_height);
 	if (letterboxed)
 		xsdk_log_write("display: xsdk_present letterboxes its frames, as %s",
 			video.is_widescreen ? "the title asks" : "the screen is 4:3");
@@ -229,10 +237,11 @@ NTSTATUS xsdk_display_open(XsdkDisplayMode mode, uint32_t *width, uint32_t *heig
 		.x_end = gpu_registers[D1GRPH_X_END],
 		.y_end = gpu_registers[D1GRPH_Y_END],
 	};
-	scaling = mode == XSDK_DISPLAY_720P && plan_scaler();
+	scaling = mode != XSDK_DISPLAY_KERNEL && plan_scaler(mode);
 	scaler_applied = false;
-	*width = scaling ? WIDTH_720P : viewport >> 16;
