+	*width = scaling ? mode_width : viewport >> 16;
+	*height = scaling ? mode_height : viewport & 0xFFFF;
+	mode_width = *width;
 	mode_height = *height;
 	is_open = true;
 	return STATUS_SUCCESS;
@@ -303,7 +312,7 @@ NTSTATUS xsdk_display_show(uint32_t address, uint32_t pitch_pixels)
 	const Surface surface = { .address = address, .pitch = pitch_pixels, .x_end = pitch_pixels, .y_end = mode_height };
 	if (!scaling)
 		return apply(&surface);
-	DisplaySize size = { .pitch = pitch_pixels, .width = WIDTH_720P, .height = mode_height };
+	DisplaySize size = { .pitch = pitch_pixels, .width = mode_width, .height = mode_height };
 	memcpy(size.scaler, new_scaler, sizeof size.scaler);
 	return xsdk_display_show_sized(address, &size);
 }
